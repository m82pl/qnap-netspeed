# Przypięte wersje narzędzi i źródeł (spec pkt 11.1).
# Plik jest czytany przez CI jako KLUCZ=wartość (bez cudzysłowów, bez rozwijania zmiennych)
# oraz może być wczytany przez POSIX sh (`. third_party/versions.env`).
# Zmiana wersji = zmiana tego pliku w PR; CI weryfikuje sumy i commity.

# Go: musi być równe dyrektywie `go` w go.mod (sprawdza job `test`).
GO_VERSION=1.27.3

# librespeed-cli (LGPL-3.0), silnik WAN. Tag i SHA commita tagu (zweryfikowane git ls-remote, 2026-11-02).
LIBRESPEED_CLI_REPO=https://github.com/librespeed/speedtest-cli
LIBRESPEED_CLI_VERSION=v1.0.14
LIBRESPEED_CLI_COMMIT=42e5f76c90e64e04ab7079fd76d833dfe41805da

# iperf3 (BSD-3-Clause), silnik LAN. W3: najnowsze stabilne wydanie 3.22 (2026-09-29).
# SHA-256 tarballa z ogłoszenia wydania (GitHub esnet/iperf discussions #2082 i lista iperf-dev; obie zgodne).
IPERF3_VERSION=3.22
IPERF3_URL=https://downloads.es.net/pub/iperf/iperf-3.22.tar.gz
IPERF3_SHA256=1c0d0fb02c52626111d6e132db80edfbf27bbaff8bd9245df2a371dcb0b35a92

# Obraz Alpine do statycznej budowy iperf3 na musl (indeks wieloarchitekturowy: amd64, arm64 i inne).
ALPINE_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# QDK 2.5.0 (używany od F1 w jobie `package`).
QDK_DEB_URL=https://github.com/qnap-dev/QDK/releases/download/v2.5.0/qdk_2.5.0_amd64.deb
QDK_DEB_SHA256=66ea6ac9c0de90959395f35ff6cd706fffb09fd92038a16dc50e99927df087a7
